\begin_layout Section
Conjecture 15 in 
\begin_inset CommandInset citation
LatexCommand cite
key "claesson2023permutationsinversions"
literal "true"

\end_inset


\end_layout

\begin_layout Standard
\noindent
\align center

\color gray
A proposed proof.
\end_layout

\begin_layout Standard
We will use both the function 
\begin_inset Formula $\omega(k)$
\end_inset

 (cf.
 
\begin_inset CommandInset href
LatexCommand href
name "OEIS A010815(k)"
target "https://oeis.org/A010815"
literal "false"

\end_inset

) introduced in Section 1 and the function 
\begin_inset Formula $\omega_{n}(k)$
\end_inset

 (cf.
 
\begin_inset CommandInset href
LatexCommand href
name "OEIS A231599(n,k)"
target "https://oeis.org/A231599"
literal "false"

\end_inset

) defined in Section 5.
 The latter satisfies
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\omega_{n}(k)=\text{Z}_{k}(-\sigma_{n}(1),-\sigma_{n}(2),\ldots,-\sigma_{n}(k))=\left[x^{k}\right]\prod_{j=1}^{n}(1-x^{j}),
\]

\end_inset


\end_layout

\begin_layout Standard
while
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\omega(k)=\omega_{\infty}(k)=\text{Z}_{k}(-\sigma(1),-\sigma(2),\ldots,-\sigma(k))=\left[x^{k}\right]\prod_{j=1}^{\infty}(1-x^{j}),
\]

\end_inset


\end_layout

\begin_layout Standard
where 
\begin_inset Formula $\sigma_{n}(k)$
\end_inset

 denotes the sum of divisors of 
\begin_inset Formula $k$
\end_inset

 that are at most 
\begin_inset Formula $n$
\end_inset

.
 Moreover, the values 
\begin_inset Formula $\omega_{n}(k)$
\end_inset

 satisfy the recurrence relation 
\begin_inset Formula 
\[
\omega_{n}(k)=\omega_{n-1}(k)-\omega_{n-1}(k-n).
\]

\end_inset


\end_layout

\begin_layout Standard
The image below visualizes the values of the matrix 
\begin_inset Formula $\Omega_{n,k}=\omega_{n}(k)$
\end_inset

 for 
\begin_inset Formula $0\leq n,k\leq150$
\end_inset

, where black corresponds to 
\begin_inset Formula $-16$
\end_inset

 and white to 
\begin_inset Formula $12$
\end_inset

.
 The structure of triangular regions originating from the origin is clearly
 visible.
 Within each such region, the bands run parallel to the lower boundary of
 the domain.
 (The vertical lines descend at the generalized pentagonal numbers, that
 is, at those values of 
\begin_inset Formula $k$
\end_inset

 where 
\begin_inset Formula $\omega(k)\neq0$
\end_inset

.) 
\emph on
Essentially, the conjecture concerns the prominent bands running parallel
 to the main diagonal in the region
\emph default
 
\begin_inset Formula $n\leq k\leq2n+1$
\end_inset

.
 This phenomenon is precisely explained by the statement below, which is
 the central claim of the entire proof.
\end_layout

\begin_layout Standard
\noindent
\align center
\begin_inset Graphics
	filename omegankszurke.png
	height 5cm

\end_inset


\begin_inset space \hspace{}
\length 2mm
\end_inset


\begin_inset Graphics
	filename omegankszurkesav.png
	width 6.51cm
	height 5cm

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Box Shaded
position "t"
hor_pos "c"
has_inner_box 1
inner_pos "t"
use_parbox 0
use_makebox 0
width "100col%"
special "none"
height "1in"
height_special "totalheight"
thickness "0.4pt"
separation "3pt"
shadowsize "4pt"
framecolor "black"
backgroundcolor "none"
status open

\begin_layout Claim
\begin_inset CommandInset label
LatexCommand label
name "claim:base "

\end_inset

Let 
\begin_inset Formula $n$
\end_inset

 be an arbitrary non-negative integer.
 Then, for every integer 
\begin_inset Formula $k$
\end_inset

 satisfying 
\begin_inset Formula $n\leq k\leq2n+1$
\end_inset

, the following relation holds:
\begin_inset Formula 
\[
\omega_{n}(k)=\omega(k)+\sum_{i=0}^{k-n-1}\omega(i).
\]

\end_inset


\end_layout

\end_inset


\end_layout

\begin_layout Proof
Let 
\begin_inset Formula $\Omega(x)=\prod_{j=1}^{\infty}(1-x^{j})=\sum_{j=0}^{\infty}\omega(j)x^{j}$
\end_inset

 and 
\begin_inset Formula $\Omega_{n}(x)=\prod_{j=1}^{n}(1-x^{j})=\sum_{j=0}^{\infty}\omega_{n}(j)x^{j}$
\end_inset

.
 By definition, we have 
\begin_inset Formula 
\[
\Omega_{n}(x)=\Omega(x)\left(\prod_{j=n+1}^{\infty}(1-x^{j})\right)^{-1}.
\]

\end_inset


\end_layout

\begin_layout Proof
In the infinite product 
\begin_inset Formula $\prod_{j=n+1}^{\infty}(1-x^{j})=(1-x^{n+1})(1-x^{n+2})\cdots(1-x^{2n+1})(1-x^{2n+2})\cdots$
\end_inset

, multiplying any two or more non-constant components produces a term of
 degree at least 
\begin_inset Formula $2n+3$
\end_inset

.
 Thus, any contribution to degrees strictly less than 
\begin_inset Formula $2n+2$
\end_inset

 must come from choosing the non-constant term from at most one factor.
 Therefore, 
\begin_inset Formula 
\[
\prod_{j=n+1}^{\infty}(1-x^{j})=1-x^{n+1}-x^{n+2}-\cdots-x^{2n+1}-\mathcal{O}(x^{2n+2}).
\]

\end_inset

Consequently, to determine the coefficients up to order 
\begin_inset Formula $2n+1$
\end_inset

 in the corresponding power series expansion, it suffices to examine the
 truncated inverse 
\begin_inset Formula $\left(1-\sum_{i=n+1}^{2n+1}x^{i}\right)^{-1}$
\end_inset

.
 Expanding this via a standard geometric series gives 
\begin_inset Formula 
\[
\left(1-\sum_{i=n+1}^{2n+1}x^{i}\right)^{-1}=1+\sum_{i=n+1}^{2n+1}x^{i}+\left(\sum_{i=n+1}^{2n+1}x^{i}\right)^{2}+\cdots.
\]

\end_inset

Since the lowest degree of 
\begin_inset Formula $\left(\sum_{i=n+1}^{2n+1}x^{i}\right)^{m}$
\end_inset

 for 
\begin_inset Formula $m\geq2$
\end_inset

 is 
\begin_inset Formula $2(n+1)=2n+2$
\end_inset

, we obtain 
\begin_inset Formula 
\[
\left(\prod_{j=n+1}^{\infty}(1-x^{j})\right)^{-1}=1+\sum_{i=n+1}^{2n+1}x^{i}+\mathcal{O}(x^{2n+2}),
\]

\end_inset


\end_layout

\begin_layout Proof
and thus 
\begin_inset Formula 
\[
\Omega_{n}(x)=\left(\sum_{j=0}^{\infty}\omega(j)x^{j}\right)\left(1+\sum_{j=n+1}^{2n+1}x^{j}+\mathcal{O}(x^{2n+2})\right).
\]

\end_inset


\end_layout

\begin_layout Proof
In this product, the coefficient of 
\begin_inset Formula $x^{k}$
\end_inset

 for 
\begin_inset Formula $n\leq k\leq2n+1$
\end_inset

 is 
\begin_inset Formula $\omega(k)+\sum_{j=n+1}^{k}\omega(k-j)$
\end_inset

.
 Substituting 
\begin_inset Formula $i=k-j$
\end_inset

 into the summation transforms the index range to 
\begin_inset Formula $0\leq i\leq k-n-1$
\end_inset

, which gives 
\begin_inset Formula $\sum_{i=0}^{k-n-1}\omega(i)$
\end_inset

.
 This proves that for any 
\begin_inset Formula $n\leq k\leq2n+1$
\end_inset

,
\begin_inset Formula 
\[
\omega_{n}(k):=\left[x^{k}\right]\Omega_{n}(x)=\omega(k)+\sum_{i=0}^{k-n-1}\omega(i),
\]

\end_inset


\end_layout

\begin_layout Proof
which completes the proof.
\end_layout

\begin_layout Corollary
\begin_inset CommandInset label
LatexCommand label
name "cor:elso"

\end_inset

For any non-negative integer 
\begin_inset Formula $j$
\end_inset

, we have 
\begin_inset Formula 
\[
\omega_{j}(j+1)=\omega(j+1)+1.
\]

\end_inset


\end_layout

\begin_layout Proof
Apply the previous 
\emph on
Claim
\emph default
 
\begin_inset CommandInset ref
LatexCommand ref
reference "claim:base "
plural "false"
caps "false"
noprefix "false"

\end_inset

 by setting 
\begin_inset Formula $n=j$
\end_inset

 and 
\begin_inset Formula $k=j+1$
\end_inset

.
 Since the condition 
\begin_inset Formula $j\le j+1\le2j+1$
\end_inset

 holds for all 
\begin_inset Formula $j\ge0$
\end_inset

, the identity implies
\begin_inset Formula 
\[
\omega_{j}(j+1)=\omega(j+1)+\sum_{i=0}^{0}\omega(i)=\omega(j+1)+\omega(0).
\]

\end_inset

The result follows immediately since 
\begin_inset Formula $\omega(0)=1$
\end_inset

 by definition.
\end_layout

\begin_layout Corollary
\begin_inset CommandInset label
LatexCommand label
name "cor:kettojpluszketto"

\end_inset

For any non-negative integer 
\begin_inset Formula $j$
\end_inset

, the following identity holds:
\begin_inset Formula 
\[
\omega_{j}(2j+2)=\omega(2j+2)+\sum_{l=0}^{j+1}\omega(l)+1.
\]

\end_inset


\end_layout

\begin_layout Proof
Setting 
\begin_inset Formula $n=j+1$
\end_inset

 and 
\begin_inset Formula $k=2j+2$
\end_inset

 in 
\emph on
Claim
\emph default
 
\begin_inset CommandInset ref
LatexCommand ref
reference "claim:base "
plural "false"
caps "false"
noprefix "false"

\end_inset

 satisfies the condition 
\begin_inset Formula $n\le k\le2n+1$
\end_inset

.
 Direct substitution yields the evaluation for the higher index: 
\begin_inset Formula 
\[
\omega_{j+1}(2j+2)=\omega(2j+2)+\sum_{l=0}^{j}\omega(l).
\]

\end_inset

By the recurrence relation 
\begin_inset Formula $\omega_{n}(k)=\omega_{n-1}(k)-\omega_{n-1}(k-n)$
\end_inset

 with 
\begin_inset Formula $n=j+1$
\end_inset

 and 
\begin_inset Formula $k=2j+2$
\end_inset

, we express the left-hand side as 
\begin_inset Formula 
\[
\omega_{j+1}(2j+2)=\omega_{j}(2j+2)-\omega_{j}(j+1).
\]

\end_inset

Rearranging terms and applying 
\emph on
Corollary
\emph default
 
\begin_inset CommandInset ref
LatexCommand ref
reference "cor:elso"
plural "false"
caps "false"
noprefix "false"

\end_inset

 to substitute 
\begin_inset Formula $\omega_{j}(j+1)=\omega(j+1)+1$
\end_inset

 leads to 
\begin_inset Formula 
\[
\omega_{j}(2j+2)=\omega_{j+1}(2j+2)+\omega(j+1)+1.
\]

\end_inset

Combining these relations and incorporating 
\begin_inset Formula $\omega(j+1)$
\end_inset

 into the summation concludes the proof.
\end_layout

\begin_layout Standard

\emph on
Our goal is to show that for every positive integer 
\begin_inset Formula $i$
\end_inset

, the function 
\begin_inset Formula $P_{i}(x):=\left(S_{-i}(x)x^{i}-S_{0}(x)C(x)^{-i}\right)(1-x)^{i}$
\end_inset

 is polynomial of degree 
\begin_inset Formula $3i-2$
\end_inset

.
 Our entirely elementary and constructive approach provides the exact formula
 for the polynomials 
\begin_inset Formula $P_{i}(x)$
\end_inset

.
\end_layout

\begin_layout Standard
To this end, we first establish the fundamental relations underpinning our
 computations and clarify their connection to the notation and preliminaries
 introduced in 
\begin_inset CommandInset citation
LatexCommand cite
key "claesson2023permutationsinversions"
literal "true"

\end_inset

.
 Using the function 
\begin_inset Formula $\omega$
\end_inset

 defined above, the Knuth–Netto formula from 
\begin_inset CommandInset citation
LatexCommand cite
key "claesson2023permutationsinversions"
literal "true"

\end_inset

 can be written in the following form: for arbitrary non-negative integers
 
\begin_inset Formula $n$
\end_inset

 and 
\begin_inset Formula $k\leq n$
\end_inset

, we have 
\begin_inset Formula 
\[
I_{n}(k)=\sum_{m=0}^{k}\binom{n+k-1-m}{n-1}\omega(m).\tag{K-N}
\]

\end_inset


\end_layout

\begin_layout Standard
We shall also rely on a generalization of the Knuth–Netto formula that holds
 for arbitrary non-negative integers 
\begin_inset Formula $n$
\end_inset

 and 
\begin_inset Formula $k$
\end_inset

, without the restriction 
\begin_inset Formula $k\leq n$
\end_inset

: 
\begin_inset Formula 
\[
I_{n}(k)=\sum_{m=0}^{k}\binom{n+k-1-m}{n-1}\omega_{n}(m).\tag{g-K-N}
\]

\end_inset

Setting 
\begin_inset Formula $k=n-i$
\end_inset

 in (g-K-N) provides
\begin_inset Formula 
\[
I_{n}(n-i)=\sum_{m=0}^{n-i}\binom{2n-i-1-m}{n-1}\omega_{n}(m),
\]

\end_inset

which allows us to represent 
\begin_inset Formula $S_{i}(x)$
\end_inset

 for any integer 
\begin_inset Formula $i\in\mathbb{Z}$
\end_inset

 as
\begin_inset Formula 
\[
S_{i}(x):=\sum_{n=0}^{\infty}I_{n}(n-i)x^{n}=\sum_{n=0}^{\infty}x^{n}\sum_{m=0}^{n-i}\binom{2n-i-1-m}{n-1}\omega_{n}(m).
\]

\end_inset

Adopting the notation established in 
\begin_inset CommandInset citation
LatexCommand cite
key "claesson2023permutationsinversions"
literal "true"

\end_inset

, this series can be rewritten for 
\begin_inset Formula $i\geq0$
\end_inset

 as 
\begin_inset Formula 
\[
S_{-i}(x)=\sum_{n=0}^{\infty}x^{n}\sum_{m=0}^{n+i}\binom{2n+i-1-m}{n-1}\omega_{n}(m).
\]

\end_inset


\end_layout

\begin_layout Standard
In particular, the case 
\begin_inset Formula $i=0$
\end_inset

 reduces to 
\begin_inset Formula 
\[
S_{0}(x)=\sum_{n=0}^{\infty}I_{n}(n)x^{n}=\sum_{n=0}^{\infty}x^{n}\sum_{m=0}^{n}\binom{2n-1-m}{n-1}\omega_{n}(m).
\]

\end_inset

Finally, it is a well-known that the generating function for 
\begin_inset Formula $C(x)^{-i}$
\end_inset

 can be expressed as:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
C(x)^{-i}=1-i\sum_{n=1}^{\infty}\frac{1}{n}\binom{2n-i-1}{n-1}x^{n}
\]

\end_inset


\end_layout

\begin_layout Standard
We now proceed to compute the difference 
\begin_inset Formula $S_{-i}(x)x^{i}-S_{0}(x)C(x)^{-i}$
\end_inset

 for a fixed 
\emph on
positive
\emph default
 integer 
\begin_inset Formula $i$
\end_inset

.
 First, let us calculate the power series of the function 
\begin_inset Formula $S_{0}(x)C(x)^{-i}$
\end_inset

:
\end_layout

\begin_layout Standard
\paragraph_spacing onehalf
\noindent
\begin_inset space \hspace{}
\length 3cm
\end_inset


\begin_inset Formula ${\displaystyle S_{0}(x)C(x)^{-i}=\left(1+\sum_{n=1}^{\infty}I_{n}(n)x^{n}\right)\left(1-i\sum_{n=1}^{\infty}\frac{1}{n}\binom{2n-i-1}{n-1}x^{n}\right)=}$
\end_inset


\begin_inset VSpace 2mm
\end_inset


\end_layout

\begin_layout Standard
\paragraph_spacing onehalf
\noindent
\begin_inset space \hspace{}
\length 3cm
\end_inset


\begin_inset Formula ${\displaystyle =1+\sum_{n=1}^{\infty}I_{n}(n)x^{n}-i\sum_{n=1}^{\infty}\frac{1}{n}\binom{2n-i-1}{n-1}x^{n}-i\left(\sum_{n=1}^{\infty}I_{n}(n)x^{n}\right)\left(\sum_{n=1}^{\infty}\frac{1}{n}\binom{2n-i-1}{n-1}x^{n}\right)=}$
\end_inset


\begin_inset VSpace 2mm
\end_inset


\end_layout

\begin_layout Standard
\paragraph_spacing onehalf
\noindent
\begin_inset space \hspace{}
\length 3cm
\end_inset


\begin_inset Formula ${\displaystyle =1+\sum_{n=1}^{\infty}\left[I_{n}(n)-\frac{i}{n}\binom{2n-i-1}{n-1}\right]x^{n}-i\sum_{n=2}^{\infty}x^{n}\sum_{k=1}^{n-1}\frac{1}{k}\binom{2k-i-1}{k-1}I_{n-k}(n-k)=}$
\end_inset


\begin_inset VSpace 2mm
\end_inset


\end_layout

\begin_layout Standard
\paragraph_spacing onehalf
\noindent
\begin_inset space \hspace{}
\length 3cm
\end_inset


\begin_inset Formula ${\displaystyle =1-ix+\sum_{n=2}^{\infty}\left[I_{n}(n)-\frac{i}{n}\binom{2n-i-1}{n-1}-i\sum_{k=1}^{n-1}\frac{1}{k}\binom{2k-i-1}{k-1}I_{n-k}(n-k)\right]x^{n}.}$
\end_inset


\begin_inset VSpace 2mm
\end_inset


\end_layout

\begin_layout Standard
Next, we also compute the power series of 
\begin_inset Formula $S_{-i}(x)x^{i}$
\end_inset

:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
S_{-i}(x)x^{i}=\sum_{N=0}^{\infty}x^{N+i}\sum_{m=0}^{N+i}\binom{2N+i-1-m}{N-1}\omega_{N}(m)=\sum_{n=i}^{\infty}x^{n}\sum_{m=0}^{n}\binom{2n-i-1-m}{n-i-1}\omega_{n-i}(m),
\]

\end_inset


\end_layout

\begin_layout Standard
where the second sum is obtained from the first by the change of index 
\begin_inset Formula $N+i=n$
\end_inset

.
 Thus, for the difference of the two functions, we can write:
\end_layout

\begin_layout Standard
\begin_inset Box Frameless
position "t"
hor_pos "c"
has_inner_box 1
inner_pos "t"
use_parbox 0
use_makebox 0
width "100col%"
special "none"
height "1in"
height_special "totalheight"
thickness "0.4pt"
separation "3pt"
shadowsize "4pt"
framecolor "black"
backgroundcolor "none"
status open

\begin_layout Plain Layout
\begin_inset Formula ${\displaystyle S_{-i}(x)x^{i}-S_{0}(x)C(x)^{-i}=}$
\end_inset


\end_layout

\begin_layout Plain Layout
\begin_inset Formula ${\displaystyle =\sum_{n=i}^{\infty}x^{n}\sum_{m=0}^{n}\binom{2n-i-1-m}{n-i-1}\omega_{n-i}(m)-1+ix-\sum_{n=2}^{\infty}\left[I_{n}(n)-\frac{i}{n}\binom{2n-i-1}{n-1}-i\sum_{k=1}^{n-1}\frac{1}{k}\binom{2k-i-1}{k-1}I_{n-k}(n-k)\right]x^{n}=}$
\end_inset


\begin_inset VSpace 2mm
\end_inset


\end_layout

\begin_layout Plain Layout
\begin_inset space \hspace{}
\length 1.4cm
\end_inset


\begin_inset Formula ${\displaystyle =-1+ix-\sum_{n=2}^{i-1}\left[I_{n}(n)-\frac{i}{n}\binom{2n-i-1}{n-1}-i\sum_{k=1}^{n-1}\frac{1}{k}\binom{2k-i-1}{k-1}I_{n-k}(n-k)\right]x^{n}+}$
\end_inset


\begin_inset VSpace 2mm
\end_inset


\end_layout

\begin_layout Plain Layout
\begin_inset space \hspace{}
\length 1.4cm
\end_inset


\begin_inset Formula ${\displaystyle +\sum_{n=i}^{\infty}x^{n}\left(\sum_{m=0}^{n}\binom{2n-i-1-m}{n-i-1}\omega_{n-i}(m)-I_{n}(n)+\frac{i}{n}\binom{2n-i-1}{n-1}+i\sum_{k=1}^{n-1}\frac{1}{k}\binom{2k-i-1}{k-1}I_{n-k}(n-k)\right).}$
\end_inset


\end_layout

\end_inset


\end_layout

\begin_layout Standard
\begin_inset VSpace defskip
\end_inset


\end_layout

\begin_layout Standard
This leads to the decomposition 
\begin_inset Formula $S_{-i}(x)x^{i}-S_{0}(x)C(x)^{-i}:=A_{i}(x)+B_{i}(x)$
\end_inset

, where 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{eqnarray*}
A_{i}(x) & = & -1+i\,x-\sum_{n=2}^{i-1}\left(I_{n}(n)-\frac{i}{n}\binom{2n-i-1}{n-1}-i\sum_{k=1}^{n-1}\frac{1}{k}\binom{2k-i-1}{k-1}I_{n-k}(n-k)\right)x^{n}\\
B_{i}(x) & = & \sum_{n=i}^{\infty}\left(\sum_{k=0}^{n}\binom{2n-i-1-k}{n-i-1}\omega_{n-i}(k)-I_{n}(n)+\frac{i}{n}\binom{2n-i-1}{n-1}+i\sum_{k=1}^{n-1}\frac{1}{k}\binom{2k-i-1}{k-1}I_{n-k}(n-k)\right)x^{n}
\end{eqnarray*}

\end_inset


\end_layout

\begin_layout Standard
Since the degree of 
\begin_inset Formula $A_{i}(x)$
\end_inset

 is at most 
\begin_inset Formula $i-1$
\end_inset

, implying that 
\begin_inset Formula $\deg\left(P_{i,A}(x)\right):=\deg\left(A_{i}(x)(1-x)^{i}\right)\leq2i-1$
\end_inset

, it suffices to show that 
\begin_inset Formula $P_{i,B}(x):=B_{i}(x)(1-x)^{i}$
\end_inset

 is also a polynomial with degree 
\begin_inset Formula $3i-2$
\end_inset

.
 (The polynomials 
\begin_inset Formula $P_{i,A}(x)$
\end_inset

, 
\begin_inset Formula $P_{i,B}(x)$
\end_inset

, and 
\begin_inset Formula $P_{i}(x)$
\end_inset

 for values of 
\begin_inset Formula $i$
\end_inset

 from 
\begin_inset Formula $2$
\end_inset

 to 
\begin_inset Formula $6$
\end_inset

 are presented in Table 
\begin_inset CommandInset ref
LatexCommand ref
reference "Table-6.-Polynomials"
plural "false"
caps "false"
noprefix "false"

\end_inset

.) Let
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
B_{i}(x):=\sum_{n=i}^{\infty}b_{i}(n)x^{n}\text{\ensuremath{\quad}and\ensuremath{\quad} }B_{i}(x)(1-x)^{i}:=\sum_{n=i}^{\infty}T_{i}(n)x^{n}.
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Box Shaded
position "t"
hor_pos "c"
has_inner_box 1
inner_pos "t"
use_parbox 0
use_makebox 0
width "100col%"
special "none"
height "1in"
height_special "totalheight"
thickness "0.4pt"
