\begin_layout Conjecture
For all weight 
\begin_inset Formula $n\geq3$
\end_inset

 the number of linearly independent relations of Ihara-Kaneko-Zagier derivation
 relation can be calculated by the following Euler-type pentagonal formula:
\begin_inset Formula 
\[
\mathscr{L}(n)=2^{n-2-P_{1}}+2^{n-2-P_{2}}-2^{n-2-P_{3}}-2^{n-2-P_{4}}\pm\cdots-\omega(n-1)-1=-\sum_{k=1}^{n-2}\omega(k)\,2^{n-2-k}-\omega(n-1)-1.
\]

\end_inset

 The generating function of 
\begin_inset Formula $\mathscr{L}(n)$
\end_inset

 is given by: 
\begin_inset Formula 
\[
{\displaystyle F(x)=\frac{x^{2}}{x-1}+\frac{x(x-1)}{2x-1}\prod_{k\geq1}(1-x^{k})},
\]

\end_inset

and 
\begin_inset Formula $\mathscr{L}(n)$
\end_inset

 satisfies the following recurrence relation for all 
\begin_inset Formula $n\geq3$
\end_inset

:
\begin_inset Formula 
\[
\mathscr{L}(n+1)=2\cdot\mathscr{L}(n)+1-\omega(n)+\omega(n-1).
\]

\end_inset


\end_layout

\end_inset


\end_layout

\begin_layout Standard
