name "A333290"
target "https://oeis.org/A333290"
literal "false"

\end_inset

) defined by
\begin_inset Formula 
\[
\omega_{n}(k):=\begin{cases}
1 & \text{if }n,k=0,\\
0 & \text{if }n=0\text{ and }k>0,\\
\text{the coefficient of x^{k}}\text{ in the expansion of the product \ensuremath{{\displaystyle \prod_{j=1}^{n}(1-x^{j})}}} & \text{if }n>0\text{ and }k\geq0
\end{cases}
\]

\end_inset


\end_layout

\begin_layout Standard
For each 
