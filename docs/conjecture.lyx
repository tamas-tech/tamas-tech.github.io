\end_inset


\end_layout

\begin_layout Standard
\noindent
\align left
\begin_inset Formula $\mathscr{L}(4)=2^{2-{\color{blue}1}}+2^{2-{\color{blue}2}}-{\color{red}\omega(3)}-1=2^{1}+2^{0}-{\color{red}0}-1=2+1-1=\mathbf{2}$
\end_inset


\end_layout

\begin_layout Standard
\noindent
\align left
\begin_inset Formula $\mathscr{L}(5)=2^{3-{\color{blue}1}}+2^{3-{\color{blue}2}}-{\color{red}\omega(4)}-1=2^{2}+2^{1}-{\color{red}0}-1=4+2-1=\mathbf{5}$
\end_inset


\end_layout

\begin_layout Standard
\noindent
\align left
\begin_inset Formula $\mathscr{L}(6)=2^{4-{\color{blue}1}}+2^{4-{\color{blue}2}}-{\color{red}\omega(5)}-1=2^{3}+2^{2}-{\color{red}1}-1=8+4-1-1=\mathbf{10}$
\end_inset


\end_layout

\begin_layout Standard
