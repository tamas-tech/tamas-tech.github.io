\begin_layout Proof
\begin_inset Argument 1
status open

\begin_layout Plain Layout
Proof of (B)
\end_layout

\end_inset

According to the generalized Knuth-Netto formula and the identity 
\begin_inset Formula $\omega_{n}(k)=\text{Z}_{k}(-\sigma_{n}(1),-\sigma_{n}(2),\ldots,-\sigma_{n}(k))$
\end_inset

, we have:
\begin_inset Formula 
\[
I_{j+1}(i-1)=\sum_{m=0}^{i-1}\binom{j+1+i-1-1-m}{j+1-1}\omega_{j+1}(m)=\sum_{m=0}^{i-1}\binom{j+i-1-m}{j}\text{Z}_{m}(-\sigma_{j+1}(1),-\sigma_{j+1}(2),\ldots,-\sigma_{j+1}(k))
\]

\end_inset

Substituting this into the left-hand side of statement (B) , we obtain:
\begin_inset Formula 
\[
\sum_{j=n-2i}^{n-i}(-1)^{j}\binom{i}{n-j-i}\sum_{m=0}^{i-1}\binom{j+i-1-m}{j}\text{Z}_{m}(-\sigma_{j+1}(1),-\sigma_{j+1}(2),\ldots,-\sigma_{j+1}(k)).
\]

\end_inset

Since 
\begin_inset Formula $n\geq3i-2$
\end_inset

, it follows that 
\begin_inset Formula $j+1\geq n-2i+1\geq3i-2-2i+1=i-1\geq m$
\end_inset

.
 Consequently, for any index 
\begin_inset Formula $0\leq m\leq i-1$
\end_inset

 in the summation, we can write
\begin_inset Formula 
\[
\text{Z}_{m}(-\sigma_{j+1}(1),-\sigma_{j+1}(2),\ldots,-\sigma_{j+1}(k))=\text{Z}_{m}(-\sigma(1),-\sigma(2),\ldots,-\sigma(k)).
\]

\end_inset

Due to the independence of the indices 
\begin_inset Formula $j$
\end_inset

 and 
\begin_inset Formula $m$
\end_inset

, the order of summation can be reversed, giving 
\begin_inset Formula 
\[
\sum_{m=0}^{i-1}\text{Z}_{m}(-\sigma(1),-\sigma(2),\ldots,-\sigma(k))\sum_{j=n-2i}^{n-i}(-1)^{j}\binom{i}{n-j-i}\binom{j+i-1-m}{j}.
\]

\end_inset

By 
\emph on
Claim 
\begin_inset CommandInset ref
LatexCommand ref
reference "claim:For-any-non-negative"
plural "false"
caps "false"
noprefix "false"

\end_inset

,
\emph default
 which asserts that:
\begin_inset Formula 
\[
\sum_{j=0}^{n-i}(-1)^{j}\binom{i}{n-j-i}\binom{j+i-1-m}{j}=\binom{m}{n-i},
\]

\end_inset

this expression can be reduced to the simpler form:
\begin_inset Formula 
\[
\sum_{m=0}^{i-1}\binom{m}{n-i}\text{Z}_{m}(-\sigma(1),-\sigma(2),\ldots,-\sigma(k)).
\]

\end_inset

Since 
\begin_inset Formula $i>1$
\end_inset

, we find that 
\begin_inset Formula $n-i\ge3i-2-i=2i-2>i-1\geq m$
\end_inset

, which implies 
\begin_inset Formula $\binom{m}{n-i}=0$
\end_inset

.
 Therefore, every binomial coefficient in the summation vanishes, causing
 the entire sum to equal zero.
 
\end_layout

