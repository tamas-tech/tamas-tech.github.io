\begin_layout Claim
For any integers 
\begin_inset Formula $i\geq2$
\end_inset

 and 
\begin_inset Formula $n\geq3i-2$
\end_inset

, the following relation holds:
\end_layout

\begin_layout Claim
\noindent

\shape smallcaps
\begin_inset Formula 
\[
\sum_{j=n-2i}^{n-i}(-1)^{j}\binom{i}{n-j-i}I_{j+1}(i-1)=0.\tag{B}
\]

\end_inset


\end_layout

\end_inset


\end_layout

