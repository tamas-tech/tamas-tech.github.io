shadowsize "4pt"
framecolor "black"
backgroundcolor "none"
status open

\begin_layout Plain Layout
(C) 
\begin_inset space \hspace{}
\length 2mm
\end_inset

In terms of these coefficients, the conjecture is equivalent to stating
 that 
\begin_inset Formula $T_{i}(3i-2)\neq0$
\end_inset

 and 
\begin_inset Formula $T_{i}(n)=0$
\end_inset

 for all 
\begin_inset Formula $n>3i-2$
\end_inset

 .
\end_layout

\end_inset


\end_layout

\begin_layout Standard
To determine the values of 
\begin_inset Formula $T_{i}(n)$
\end_inset

, we first rewrite 
\begin_inset Formula $b_{i}(n)$
\end_inset

 in a more compact form.
 By definition
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
b_{i}(n):=\sum_{k=0}^{n}\binom{2n-i-1-k}{n-i-1}\omega_{n-i}(k)-I_{n}(n)+\frac{i}{n}\binom{2n-i-1}{n-1}+i\sum_{k=1}^{n-1}\frac{1}{k}\binom{2k-i-1}{k-1}I_{n-k}(n-k).
\]

\end_inset


\end_layout

\begin_layout Standard
The term 
\begin_inset Formula $I_{n}(n)$
\end_inset

 can be transformed into the sum 
\begin_inset Formula $\sum_{k=0}^{n}\binom{2n-1-k}{n-1}\omega(k)$
\end_inset

 by using the Knuth-Netto formula, and 
\begin_inset Formula $\frac{i}{n}\binom{2n-i-1}{n-1}$
\end_inset

 can be incorporated into the second summation by setting 
\begin_inset Formula $k=n$
\end_inset

.
 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
b_{i}(n)=\sum_{k=0}^{n}\left[\binom{2n-i-1-k}{n-i-1}\omega_{n-i}(k)-\binom{2n-1-k}{n-1}\omega(k)\right]+i\sum_{k=1}^{n}\frac{1}{k}\binom{2k-i-1}{k-1}I_{n-k}(n-k).
\]

\end_inset


\end_layout

\begin_layout Standard
Applying the Knuth-Netto formula once again, the second term can be written
 as
\begin_inset Formula 
\[
{\displaystyle \sum_{k=1}^{n}\frac{1}{k}I_{n-k}(n-k)\binom{2k-i-1}{k-1}=\sum_{k=1}^{n}\frac{1}{k}\binom{2k-i-1}{k-1}\sum_{m=0}^{n-k}\binom{2n-2k-1-m}{n-k-1}\omega(m)},
\]

\end_inset

which, after interchanging the order of summation, takes the form
\begin_inset Formula 
\[
\sum_{m=0}^{n-1}\omega(m)\sum_{k=1}^{n-m}\frac{1}{k}\binom{2k-i-1}{k-1}\binom{2n-2k-1-m}{n-k-1}.
\]

\end_inset

To align the summation indices across both main terms, we swap the dummy
 indices 
\begin_inset Formula $m$
\end_inset

 and 
\begin_inset Formula $k$
\end_inset

, leading to the formula:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
b_{i}(n)=\sum_{k=0}^{n}\left[\binom{2n-i-1-k}{n-i-1}\omega_{n-i}(k)-\binom{2n-1-k}{n-1}\omega(k)\right]+i\sum_{k=0}^{n-1}\omega(k)\sum_{m=1}^{n-k}\frac{1}{m}\binom{2m-i-1}{m-1}\binom{2n-2m-1-k}{n-m-1}.
\]

\end_inset


\end_layout

\begin_layout Standard
Since the inner sum vanishes for 
\begin_inset Formula $k=n$
\end_inset

 (as it becomes an empty sum running from 
\begin_inset Formula $m=1$
\end_inset

 to 
\begin_inset Formula $0$
\end_inset

), the upper bound of the second summation can be extended from 
\begin_inset Formula $n-1$
\end_inset

 to 
\begin_inset Formula $n$
\end_inset

:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
b_{i}(n)=\sum_{k=0}^{n}\left[\binom{2n-i-1-k}{n-i-1}\omega_{n-i}(k)-\binom{2n-1-k}{n-1}\omega(k)\right]+i\sum_{k=0}^{n}\omega(k)\sum_{m=1}^{n-k}\frac{1}{m}\binom{2m-i-1}{m-1}\binom{2n-2m-1-k}{n-m-1}.
\]

\end_inset


\end_layout

\begin_layout Standard
Collecting the terms containing 
\begin_inset Formula $\omega(k)$
\end_inset

 into the second summation, we obtain:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
b_{i}(n)=\sum_{k=0}^{n}\binom{2n-1-k-i}{n-1-i}\omega_{n-i}(k)+\sum_{k=0}^{n}\omega(k)\left(-\binom{2n-1-k}{n-1}+\sum_{m=1}^{n-k}\frac{i}{m}\binom{2m-i-1}{m-1}\binom{2n-2m-1-k}{n-m-1}\right).
\]

\end_inset


\end_layout

\begin_layout Standard
Applying the binomial identity of 
\emph on
Claim 
\begin_inset CommandInset ref
LatexCommand ref
reference "claim:Hagen-Rothe"
plural "false"
caps "false"
noprefix "false"

\end_inset


\emph default
, which asserts that:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
-\binom{2n-1-k}{n-1}+\sum_{m=1}^{n-k}\frac{i}{m}\binom{2m-i-1}{m-1}\binom{2n-2m-1-k}{n-m-1}=\binom{2n-1-k-i}{n-1-i},
\]

\end_inset


\end_layout

\begin_layout Standard
we can bring 
\begin_inset Formula $b_{i}(n)$
\end_inset

 into the concise form:
\begin_inset Formula 
\[
b_{i}(n)=\sum_{k=0}^{n}\binom{2n-i-1-k}{n-1-i}\left(\omega_{n-i}(k)-\omega(k)\right)
\]

\end_inset


\end_layout

\begin_layout Standard
Moreover, because 
\begin_inset Formula $\omega_{n-i}(k)=\omega(k)$
\end_inset

 holds for 
\begin_inset Formula $k\leq n-i$
\end_inset

, the terms for 
\begin_inset Formula $k\le n-i$
\end_inset

 vanish.
 Thus, we only need to sum from 
\begin_inset Formula $k=n-i+1$
\end_inset

:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
b_{i}(n)=\sum_{k=n-i+1}^{n}\binom{2n-i-1-k}{n-1-i}\left(\omega_{n-i}(k)-\omega(k)\right)
\]

\end_inset


\end_layout

\begin_layout Standard
It is worth noting that 
\begin_inset Formula $b_{i}(n)$
\end_inset

 measures the difference between the value 
\begin_inset Formula $I_{n-i}^{*}(n)$
\end_inset

, computed via the Knuth-Netto formula as
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
I_{n-i}^{*}(n)\overset{\text{(K-N)}}{=}\sum_{k=0}^{n}\binom{n-i+n-1-k}{n-1}\omega(k)=\sum_{k=0}^{n}\binom{2n-i-1-k}{n-1-i}\omega(k),
\]

\end_inset


\end_layout

\begin_layout Standard
(which does not provide the correct result under the condition 
\begin_inset Formula $n>n-i$
\end_inset

), and the always correct value 
\begin_inset Formula $I_{n-i}(n)$
\end_inset

, computed according to the generalized Knuth-Netto formula as
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
I_{n-i}(n)\overset{\text{(g-K-N)}}{=}\sum_{k=0}^{n}\binom{n-i+n-1-k}{n-1}\omega_{n-i}(k)=\sum_{k=0}^{n}\binom{2n-i-1-k}{n-1-i}\omega_{n-i}(k),
\]

\end_inset


\end_layout

\begin_layout Standard
that is, 
\begin_inset Formula $b_{i}(n)=I_{n-i}(n)-I_{n-i}^{*}(n)$
\end_inset

.
\end_layout

\begin_layout Standard
Now, the desired coefficients 
\begin_inset Formula $T_{i}(n)$
\end_inset

 can be easily determined; since
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
B_{i}(x)(1-x)^{i}=\left(\sum_{j=i}^{\infty}b_{i}(j)x^{j}\right)\left(\sum_{k=0}^{i}(-1)^{k}\binom{i}{k}x^{k}\right)=\sum_{j+k=n}(-1)^{k}\binom{i}{k}b_{i}(j)x^{n}=\sum_{j=i}^{n}(-1)^{n-j}\binom{i}{n-j}b_{i}(j)x^{n},
\]

\end_inset


\end_layout

\begin_layout Standard
it follows that
\begin_inset Formula 
\[
T_{i}(n)=(-1)^{n}\sum_{j=i}^{n}(-1)^{j}\binom{i}{n-j}\sum_{k=j-i+1}^{j}\binom{2j-i-1-k}{j-1-i}\left(\omega_{j-i}(k)-\omega(k)\right).
\]

\end_inset


\end_layout

\begin_layout Standard
Shifting the summation index by substituting 
\begin_inset Formula $j\longrightarrow j-i$
\end_inset

, we obtain: 
\end_layout

\begin_layout Standard
\begin_inset Box Shaded
position "t"
hor_pos "c"
has_inner_box 1
inner_pos "t"
use_parbox 0
use_makebox 0
width "100col%"
special "none"
height "1in"
height_special "totalheight"
thickness "0.4pt"
separation "3pt"
shadowsize "4pt"
framecolor "black"
backgroundcolor "none"
status open

\begin_layout Plain Layout
\begin_inset Formula 
\[
T_{i}(n)=(-1)^{n+i}\sum_{j=\max(0,n-2i)}^{n-i}(-1)^{j}\binom{i}{n-j-i}\sum_{k=j+1}^{j+i}\binom{2j+i-1-k}{j-1}\left(\omega_{j}(k)-\omega(k)\right)\tag{T}
\]

\end_inset


\end_layout

\end_inset


\end_layout

\begin_layout Standard
Based on extensive computer verification, we propose the following claim:
\end_layout

\begin_layout Standard
\begin_inset Box Shaded
