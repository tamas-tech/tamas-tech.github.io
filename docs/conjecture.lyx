\begin_layout Standard
The fact that the powers of two appear in the first row of the empirical
 rank-increment matrix 
\begin_inset Formula $\mathbf{R}$
\end_inset

 is theoretically straightforward to verify; specifically, 
\begin_inset Formula $\text{rank}(\partial_{1}(\mathcal{A}_{n}))=2^{n-3}$
\end_inset

 for 
\begin_inset Formula $n\ge3$
\end_inset

.
 Indeed, the cardinality of the underlying set is given by 
\begin_inset Formula $|\mathcal{A}_{n-1}|=|x\mathfrak{H}_{n-3}y|=2^{n-3}$
\end_inset

.
 To establish the linear independence of the vector system 
\begin_inset Formula $\partial_{1}(\mathcal{A}_{n-1})$
\end_inset

, it suffices to examine the first term of the derivative of each word 
\begin_inset Formula $w\in\mathcal{A}_{n}$
\end_inset

 with respect to the ordering fixed in Chapter 3.
 Consequently, to complete the proof of Conjecture 1, it suffices to demonstrate
 that under the appropriate reindexing, the defined rank increments 
\begin_inset Formula $r_{m,n}$
\end_inset

 satisfy the recurrence relation prescribed in the definition of the pentagonal
 transform.
 
\end_layout

\begin_layout Standard
To further investigate the underlying algebraic foundations, it is highly
 instructive that the matrix can be viewed as a two-dimensional extension
 
\begin_inset Formula $\mathbf{pic}_{n}(k)$
\end_inset

 of the sequence of pure inverting compositions 
\begin_inset Formula $\mathbf{pic}(k)$
\end_inset

, as discussed in detail in the preceding section.
 In view of what is described there, 
\emph on
Conjecture 1 would follow from directly showing that
\emph default
 the vector system 
\begin_inset Formula $\partial_{m}(\mathcal{A}_{k})$
\end_inset

 increases the rank of the system 
\begin_inset Formula 
\[
\bigcup_{j=1}^{m-1}\partial_{m-j}(\mathcal{A}_{k+j})=\partial_{m-1}(\mathcal{A}_{k+1})\cup\partial_{m-2}(\mathcal{A}_{k+2})\cup\dots\cup\partial_{1}(\mathcal{A}_{k+m-1})
\]

\end_inset

 by exactly 
\begin_inset Formula 
\[
\sum_{i=0}^{k}p_{{\scriptscriptstyle >}m}(i)\cdot\text{pic}(k-i)=p_{{\scriptscriptstyle >}m}(0)\,\text{pic}(k)+p_{{\scriptscriptstyle >}m}(1)\,\text{pic}(k-1)+\cdots+p_{{\scriptscriptstyle >}m}(k-1)\,\text{pic}(1)+p_{{\scriptscriptstyle >}m}(k)\,\text{pic}(0).
\]

\end_inset


\end_layout

\begin_layout Standard
To conclude this chapter, we provide an algebraic formulation of the pentagonal
 transform using the framework of generating functions.
 Let 
\begin_inset Formula $A(x)=\sum_{k=0}^{\infty}a(k)x^{k}$
\end_inset

 be the ordinary generating function of an arbitrary sequence 
\begin_inset Formula $\mathbf{a}$
\end_inset

 with 
\begin_inset Formula $a(0)=1$
\end_inset

.
 Specifically, the generating function for the 
\begin_inset Formula $k$
\end_inset

-th row of the transformation matrix is given by 
\begin_inset Formula 
\[
A(x)\,x^{k}\prod_{j=1}^{k}(1-x^{j})\,\,\,\,(k=0,1,2,\ldots).
\]

\end_inset


\end_layout

\begin_layout Standard
Consequently, the generating function of the pentagonal transform of the
 sequence 
\begin_inset Formula $\mathbf{a}$
\end_inset

 can be expressed as:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\mathcal{P}(A)(x)=\sum_{k=0}^{\infty}A(x)\,x^{k}\prod_{j=1}^{k}(1-x^{j})=A(x)\,\sum_{k=0}^{\infty}x^{k}\prod_{j=1}^{k}(1-x^{j}).
\]

\end_inset


\end_layout

\begin_layout Standard
By applying Euler's Telescoping Lemma, the latter summation can be simplified
 directly to the form 
\begin_inset Formula 
\[
\sum_{k=1}^{\infty}\delta(k)x^{k},
\]

\end_inset


\end_layout

\begin_layout Standard
thus 
\begin_inset Formula 
\[
\mathcal{P}(A)(x)=A(x)\sum_{k=1}^{\infty}\delta(k)x^{k}=\sum_{j=0}^{\infty}x^{j}\sum_{l=0}^{j-1}a(l)\delta(j-l)
\]

\end_inset


\end_layout

\begin_layout Standard
which successfully recovers the global generating function of the pentagonal
 sequence 
\begin_inset Formula $\mathbf{\delta}$
\end_inset

 and confirms the validity of the convolution property.
\end_layout

\begin_layout Section
Other Conjectures on Derivation Relations
\end_layout

\begin_layout Standard
Recall that for any admissible word 
\begin_inset Formula $w\in\mathfrak{H}_{0}$
\end_inset

 and any integers 
\begin_inset Formula $a,b\geq0$
\end_inset

, the shuffle regularization of the word 
\begin_inset Formula $y^{a}wx^{b}$
\end_inset

 is given by
\begin_inset Formula 
\[
\text{reg}_{\ensuremath{\shuffle}}(y^{a}wx^{b}):=\sum_{i=0}^{a}\sum_{j=0}^{b}(-1)^{i+j}\,y^{i}\shuffle\left(y^{a-i}wx^{b-j}\right)\shuffle x^{j}
\]

\end_inset


\end_layout

\begin_layout Conjecture
(Generalized Derivation Relation) For any admissible word 
\begin_inset Formula $w\in\mathfrak{H}_{0}$
\end_inset

 and any integers 
\begin_inset Formula $n>0$
\end_inset

, 
\begin_inset Formula $a,b\geq0$
\end_inset

, and 
\begin_inset Formula $m>a+b$
\end_inset

, we have
\begin_inset Formula 
\[
\zeta\left(\text{reg}_{\ensuremath{\shuffle}}\left[\partial_{n}^{m}\left(y^{a}wx^{b}\right)\right]\right)=0.
\]

\end_inset


\end_layout

\begin_layout Standard
Moreover, the quasi-derivation relation can be generalized in a similar
 manner:
\end_layout

\begin_layout Conjecture
(Generalized Quasi-derivation Relation) For any rational number 
\begin_inset Formula $c\in\mathbb{Q}$
\end_inset

 , any admissible word 
\begin_inset Formula $w\in\mathfrak{H}_{0}$
\end_inset

 and any integers 
\begin_inset Formula $n>0$
\end_inset

, 
\begin_inset Formula $a,b\geq0$
\end_inset

, and 
\begin_inset Formula $m>a+b$
\end_inset

, we have
\begin_inset Formula 
\[
\zeta\left(\text{reg}_{\ensuremath{\shuffle}}\left[\left(\partial_{n}^{(c)}\right)^{m}\left(y^{a}wx^{b}\right)\right]\right)=0.
\]

\end_inset


\end_layout

