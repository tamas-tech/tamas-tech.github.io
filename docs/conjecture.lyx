\end_inset

, 
\begin_inset Formula $\omega_{\infty}=\omega$
\end_inset

, 
\begin_inset Formula $\mathbf{p}=\mathbf{p}_{{\scriptscriptstyle >}0}=\mathbf{p}_{{\scriptscriptstyle \leqq}\infty}$
\end_inset

, 
\begin_inset Formula $\mathbf{0}=(0,0,0,\ldots)=\mathbf{p}_{{\scriptscriptstyle >}\infty}=\mathbf{p}_{{\scriptscriptstyle \leqq}0}$
\end_inset

, 
\begin_inset Formula $\mathbf{1}=(1,1,1,\ldots)=\mathbf{p}_{{\scriptscriptstyle \leqq}1}$
