\begin_layout Proof
\begin_inset Argument 1
status open

\begin_layout Plain Layout
Proof of (A)
\end_layout

\end_inset

We first prove the first case, where 
\begin_inset Formula $j\geq i-1$
\end_inset

.
 In the sum 
\begin_inset Formula 
\[
S=\sum_{k=j+1}^{j+i}\binom{2j+i-1-k}{j-1}\left(\omega_{j}(k)-\omega(k)\right),
\]

\end_inset

the summation index 
\begin_inset Formula $k$
\end_inset

 satisfies 
\begin_inset Formula $j+1\leq k\leq j+i\leq2j+1$
\end_inset

.
 Since the conditions of
\emph on
 Claim
\emph default

\begin_inset space ~
\end_inset


\begin_inset CommandInset ref
LatexCommand ref
reference "claim:base "
plural "false"
caps "false"
noprefix "false"

\end_inset

 hold, we can expand the difference 
\begin_inset Formula $\omega_{j}(k)-\omega(k)$
\end_inset

 to rewrite the sum as 
\begin_inset Formula 
\[
S=\sum_{k=j+1}^{j+i}\binom{2j+i-1-k}{j-1}\sum_{l=0}^{k-j-1}\omega(l)=\sum_{l=0}^{i-1}\omega(l)\sum_{k=l+j+1}^{j+i}\binom{2j+i-1-k}{j-1}.
\]

\end_inset

By 
\emph on
Claim
\begin_inset space ~
\end_inset


\begin_inset CommandInset ref
LatexCommand ref
reference "claim:Le-t-and"
plural "false"
caps "false"
noprefix "false"

\end_inset


\emph default
, the inner summation simplifies to
\begin_inset Formula 
\[
\sum_{k=l+j+1}^{j+i}\binom{2j+i-1-k}{j-1}=\binom{j+i-1-l}{j}.
\]

\end_inset

Substituting this back into the expression for 
\begin_inset Formula $S$
\end_inset

 and applying the Knuth-Netto formula, we obtain 
\begin_inset Formula 
\[
S=\sum_{l=0}^{i-1}\binom{j+i-1-l}{j}\omega(l)=\sum_{l=0}^{i-1}\binom{(j+1)+(i-1)-1-l}{(j+1)-1}\omega(l)\overset{\text{(K-N)}}{=}I_{j+1}(i-1),
\]

\end_inset

which completes the proof for the case 
\begin_inset Formula $j\geq i-1$
\end_inset

.
\end_layout

\begin_layout Proof
Next, we consider the second case, where 
\begin_inset Formula $j=i-2$
\end_inset

.
 This condition implies that the upper limit of the summation becomes 
\begin_inset Formula $j+i=2j+2$
\end_inset

.
 To evaluate the sum, we isolate the final term corresponding to 
\begin_inset Formula $k=2j+2$
\end_inset

, where 
\begin_inset Formula $\binom{3j+1-(2j+2)}{j-1}=\binom{j-1}{j-1}=1$
\end_inset

: 
\begin_inset Formula 
\[
S=\sum_{k=j+1}^{2j+1}\binom{3j+1-k}{j-1}\left(\omega_{j}(k)-\omega(k)\right)+\omega_{j}(2j+2)-\omega(2j+2).
\]

\end_inset

The summation from 
\begin_inset Formula $k=j+1$
\end_inset

 to 
\begin_inset Formula $2j+1$
\end_inset

 satisfies the boundary conditions of 
\emph on
Claim
\emph default

\begin_inset space ~
\end_inset


\begin_inset CommandInset ref
LatexCommand ref
reference "claim:base "
plural "false"
caps "false"
noprefix "false"

\end_inset

, thus we can expand the difference 
\begin_inset Formula $\omega_{j}(k)-\omega(k)$
\end_inset

 to rewrite the sum as 
\begin_inset Formula 
\[
\sum_{k=j+1}^{2j+1}\binom{3j+1-k}{j-1}\left(\omega_{j}(k)-\omega(k)\right)=\sum_{k=j+1}^{2j+1}\binom{3j+1-k}{j-1}\sum_{l=0}^{k-j-1}\omega(l).
\]

\end_inset


\end_layout

\begin_layout Proof
Interchanging the order of summation and applying 
\emph on
Claim
\emph default

\begin_inset space ~
\end_inset


\begin_inset CommandInset ref
LatexCommand ref
reference "claim:Le-t-and"
plural "false"
caps "false"
noprefix "false"

\end_inset

 with the choice 
\begin_inset Formula $i=j+2$
\end_inset

, gives: 
\begin_inset Formula 
\[
\sum_{l=0}^{j}\omega(l)\sum_{k=j+1+l}^{2j+1}\binom{3j+1-k}{j-1}=\sum_{l=0}^{j}\left(\binom{2j+1-l}{j}-1\right)\omega(l)=\sum_{l=0}^{j}\binom{2j+1-l}{j}\omega(l)-\sum_{l=0}^{j}\omega(l).
\]

\end_inset


\end_layout

\begin_layout Proof
According to the Knuth–Netto formula, we have 
\begin_inset Formula 
\[
I_{j+1}(j+1)=\sum_{l=0}^{j+1}\binom{j+1+j+1-1-l}{j+1-1}\omega(l)=\sum_{l=0}^{j+1}\binom{2j+1-l}{j}\omega(l)=\sum_{l=0}^{j}\binom{2j+1-l}{j}\omega(l)+\omega(j+1).
\]

\end_inset


\end_layout

\begin_layout Proof
By combining the above relations and applying 
\emph on
Claim
\emph default
 
\begin_inset CommandInset ref
LatexCommand ref
reference "cor:kettojpluszketto"
plural "false"
caps "false"
noprefix "false"

\end_inset

, we obtain exactly the desired statement: 
\begin_inset Formula 
\[
S=I_{j+1}(j+1)-\omega(j+1)-\sum_{l=0}^{j}\omega(l)+\omega_{j}(2j+2)-\omega(2j+2)=I_{j+1}(j+1)+1.
\]

\end_inset


\end_layout

