\begin_layout Proof
Let 
\begin_inset Formula $n=3i-2$
\end_inset

.
 Since 
\begin_inset Formula $i\geq2$
\end_inset

 , we have 
\begin_inset Formula $j\geq\text{max}(0,n-2i)=\text{max}(0,i-2)=i-2$
\end_inset

.
 Therefore, we can write that
\begin_inset Formula 
\begin{gather*}
T_{i}(n)\overset{(A)}{=}(-1)^{n+i}\sum_{j=n-2i}^{n-2i}(-1)^{j}\binom{i}{n-j-i}\left(I_{j+1}(i-1)+1\right)+(-1)^{n+i}\sum_{j>n-2i}^{n-i}(-1)^{j}\binom{i}{n-j-i}I_{j+1}(i-1)=\\
=(-1)^{n+i+i-2}\binom{i}{3i-2-(i-2)-i}+(-1)^{n+i}\sum_{j=n-2i}^{n-i}(-1)^{j}\binom{i}{n-j-i}I_{j+1}(i-1)\overset{(B)}{=}(-1)^{n}\binom{i}{i}+0=(-1)^{n}.
\end{gather*}

\end_inset


\end_layout

\begin_layout Proof
This completes the proof that 
\begin_inset Formula $T_{i}(3i-2)=(-1)^{i}$
\end_inset

.
 On the other hand, if 
\begin_inset Formula $n>3i-2$
\end_inset

, then 
\begin_inset Formula $j>i-2$
\end_inset

, and thus
\end_layout

\begin_layout Proof
\begin_inset Formula 
\begin{gather*}
T_{i}(n)\overset{(A)}{=}(-1)^{n+i}\sum_{j=n-2i}^{n-i}(-1)^{j}\binom{i}{n-j-i}I_{j+1}(i-1)\overset{(B)}{=}0.
\end{gather*}

\end_inset


\end_layout

